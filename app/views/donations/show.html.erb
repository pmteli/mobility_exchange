<section class="page record-page"><%= link_to "← My account", account_path %><div class="record-header"><div><p class="eyebrow">Your donation</p><h1><%= @donation.reference_number %></h1></div><%= status_badge(@donation.status) %></div><div class="panel"><% @donation.intake_items.each do |item| %><%= render "shared/donation_photos", item: item, donation: @donation %><h3><%= item.name %></h3><p><%= item.quantity %> item(s) · <%= item.condition.humanize %></p><% end %><p><%= @donation.rejection_reason %></p></div><%= render "shared/signing", title: "Donor certification", legal: @legal, signed_records: @donation.signed_donor_certifications, record: @donation, action: sign_donation_path(@donation) %><%= render "shared/booking", title: "Arrange drop-off", record: @donation, slots: @slots, action: book_donation_path(@donation) %></section>
