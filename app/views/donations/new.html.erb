<% content_for :title, "Donate equipment | Mobility Exchange" %><div class="container page-intro"><p class="eyebrow">Pass it forward</p><h1>Give equipment a second story.</h1><p>New and gently used equipment can make a meaningful difference. Our team reviews each donation before confirming acceptance.</p></div><div class="container form-layout"><div><%= form_with url: donations_path do |f| %><section class="form-section"><div class="form-section-title"><span>01</span><h2>Donor information</h2></div><%= render "shared/contact_fields" %></section><section class="form-section"><div class="form-section-title"><span>02</span><h2>Equipment description & details</h2></div><fieldset><div class="field"><%= label_tag "item_type_id", "Equipment type" %><%= select_tag "item[type_id]", options_from_collection_for_select(@types, :id, :name), required: true, prompt: "Choose a type" %></div><div class="field"><%= label_tag "item_name", "Item name" %><%= text_field_tag "item[name]", nil, required: true, maxlength: 200, placeholder: "For example, folding walker" %></div><div class="two-col"><div class="field"><%= label_tag "item_condition", "Condition" %><%= select_tag "item[condition]", options_for_select(%w[new excellent good fair poor unknown].map { |x| [x.humanize, x] }) %></div><div class="field"><%= label_tag "item_quantity", "Quantity" %><%= number_field_tag "item[quantity]", 1, min: 1, max: 20, required: true %></div></div><div class="two-col"><div class="field"><%= label_tag "item_manufacturer", "Manufacturer" %><%= text_field_tag "item[manufacturer]", nil, maxlength: 150 %></div><div class="field"><%= label_tag "item_model", "Model" %><%= text_field_tag "item[model]", nil, maxlength: 150 %></div></div><div class="field"><%= label_tag "item_description", "Description and condition notes" %><%= text_area_tag "item[description]", nil, maxlength: 3000 %></div></fieldset></section><section class="form-section"><div class="form-section-title"><span>03</span><h2>Review & submit</h2></div><p class="form-note">The team will review your submission before arranging a drop-off. Donor certification is completed on the next page.</p><%= f.submit "Submit donation" %></section><% end %></div><aside class="form-sidebar"><%= design_icon("heart") %><h3>What can you donate?</h3><p><strong>Mobility aids</strong><br>Wheelchairs, walkers, rollators, crutches, and canes.</p><p><strong>Daily living support</strong><br>Bathroom safety equipment and other mobility aids.</p><h3>What happens next?</h3><p>Submit details → sign donor certification → team review → confirmed drop-off → inspection and preparation.</p><%= link_to page_path("contact"), class: "text-link" do %>Ask the team <%= design_icon("arrow") %><% end %></aside></div>
