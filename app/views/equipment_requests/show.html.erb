<section class="page record-page"><%= link_to "← My account", account_path %><div class="record-header"><div><p class="eyebrow">Your equipment request</p><h1><%= @equipment_request.reference_number %></h1></div><%= status_badge(@equipment_request.status) %></div><div class="panel"><% @equipment_request.request_items.includes(:equipment).each do |line| %><h3><%= line.equipment.name %></h3><p class="muted"><%= line.equipment.inventory_number %></p><% end %><% if @equipment_request.rejection_reason.present? %><p><%= @equipment_request.rejection_reason %></p><% end %></div><%= render "shared/signing", title: "Recipient waiver", legal: @legal, signed_records: @equipment_request.signed_waivers, record: @equipment_request, action: sign_equipment_request_path(@equipment_request) %><%= render "shared/booking", title: "Arrange pickup", record: @equipment_request, slots: @slots, action: book_equipment_request_path(@equipment_request) %></section>
