<% [["Find Equipment", catalogue_path, "catalog"], ["Donate Equipment", new_donation_path, "donations"], ["Donate Money", new_money_donation_path, "money_donations"], ["Volunteer", new_volunteer_application_path, "volunteer_applications"], ["About US", page_path("about"), nil], ["FAQs", page_path("faq"), nil]].each do |label, path, controller| %>
  <%= link_to label, path, aria: { current: (controller ? controller_name == controller && request.path != root_path : current_page?(path)) ? "page" : nil } %>
<% end %>
