<% [["Find equipment", catalogue_path, "catalog", nil], ["Volunteer", new_volunteer_application_path, "volunteer_applications", nil], ["About us", page_path("about"), nil, nil], ["FAQs", page_path("faq"), nil, nil], ["Support financially", new_money_donation_path, "money_donations", "exchange-financial"], ["Donate equipment", new_donation_path, "donations", "exchange-donate"]].each do |label, path, controller, css| %>
  <%= link_to path, class: css, aria: { current: (controller ? controller_name == controller && request.path != root_path : current_page?(path)) ? "page" : nil } do %><%= label %><% if css == "exchange-donate" %> <span aria-hidden="true">↗</span><% end %><% end %>
<% end %>
