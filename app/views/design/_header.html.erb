<header class="site-header"><div class="container nav-inner">
  <%= render "design/brand" %>
  <nav class="site-nav" aria-label="Main navigation"><%= render "design/navigation_links" %></nav>
  <div class="nav-right">
    <% if current_user %>
      <%= link_to "My account", account_path, class: "text-link" %>
      <%= link_to "Team portal", staff_root_path, class: "button" if staff_access? %>
      <%= button_to session_path, method: :delete, class: "icon-button", aria: { label: "Sign out" } do %><%= design_icon("logout") %><% end %>
    <% else %>
      <%= link_to "Sign in", new_session_path, class: "text-link" %>
      <%= link_to "Create account", new_registration_path, class: "button" %>
    <% end %>
  </div>
  <details class="public-menu">
    <summary><%= design_icon("menu") %><span>Menu</span></summary>
    <div class="public-menu-panel">
      <nav aria-label="Mobile navigation"><%= render "design/navigation_links" %><%= link_to "Volunteer shifts", shifts_path %><%= link_to "Contact us", page_path("contact") %></nav>
      <hr>
      <nav aria-label="Account navigation">
        <% if current_user %>
          <%= link_to "My account", account_path %>
          <%= link_to "Team portal", staff_root_path if staff_access? %>
        <% else %>
          <%= link_to "Sign in", new_session_path %><%= link_to "Create account", new_registration_path %>
        <% end %>
      </nav>
      <%= button_to "Sign out", session_path, method: :delete, class: "text-button" if current_user %>
    </div>
  </details>
</div></header>
