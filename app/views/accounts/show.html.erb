<% content_for :title, "My account | Mobility Exchange" %><section class="page"><div class="section-head"><div><p class="eyebrow">Your Mobility Exchange</p><h1>Hello, <%= current_user.first_name %>.</h1><p>Track your equipment requests, donations, and confirmed appointments.</p></div><%= link_to catalogue_path, class: "button" do %>Find equipment <%= design_icon("arrow") %><% end %></div><% if current_user.community_roles.any? %><div class="panel"><strong>Your roles:</strong> <%= current_user.community_roles.map(&:titleize).join(" · ") %><% if current_user.community_roles.include?("volunteer") && !current_user.volunteer %><p><%= link_to "Complete your volunteer application →", new_volunteer_application_path %></p><% end %></div><% end %><div class="two-col"><section><div class="section-head"><h2>Your requests</h2></div><% @requests.each do |record| %><article class="panel account-card"><div class="between"><p class="eyebrow">Equipment request</p><%= status_badge(record.status) %></div><h3><%= link_to record.reference_number, equipment_request_path(record) %></h3><p class="muted">Requested <%= local_time(record.submitted_at) %></p><%= link_to equipment_request_path(record), class: "text-link" do %>View request & next steps <%= design_icon("arrow") %><% end %></article><% end %><% if @requests.empty? %><div class="empty"><%= design_icon("box") %><h3>Your next step starts here.</h3><p>Browse available equipment and send a request. Your progress will appear here.</p><%= link_to "Explore equipment →", catalogue_path, class: "text-link" %></div><% end %></section><section><div class="section-head"><h2>Your donations</h2></div><% @donations.each do |record| %><article class="panel account-card"><div class="between"><p class="eyebrow">Equipment donation</p><%= status_badge(record.status) %></div><h3><%= link_to record.reference_number, donation_path(record) %></h3><p class="muted">Submitted <%= local_time(record.created_at) %></p><%= link_to donation_path(record), class: "text-link" do %>View donation & next steps <%= design_icon("arrow") %><% end %></article><% end %><% if @donations.empty? %><div class="empty"><%= design_icon("heart") %><h3>Give an item a new chapter.</h3><p>Your equipment could make a meaningful difference in someone's daily life.</p><%= link_to "Start a donation →", new_donation_path, class: "text-link" %></div><% end %></section></div><div class="actions"><%= link_to "Edit profile", edit_account_path, class: "button secondary" %><%= link_to "Volunteer shifts", shifts_path, class: "button secondary" %></div></section>
