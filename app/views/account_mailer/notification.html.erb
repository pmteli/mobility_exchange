<% reset = @kind == "reset" %>
<% target = @kind == "email_change" ? profile_email_url(@token) : (@kind == "verification" ? verification_url(@token) : edit_password_reset_url(@token)) %>
<% heading = reset ? "A fresh start for your password." : (@kind == "email_change" ? "Confirm your new email." : "Welcome to the exchange.") %>
<% description = reset ? "Choose a new password to get back to your Mobility Exchange account." : (@kind == "email_change" ? "Verify your new email address to finish updating your profile. Your current sign-in email stays active until you confirm." : "You're one step away from joining a community that helps mobility equipment find its next home. Verify your email address to activate your account.") %>
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= heading %></title>
<style>@media screen and (max-width:480px){.email-content{padding:28px 20px!important}.email-shell{padding:16px 8px!important}.email-title{font-size:27px!important}}</style></head>
<body style="margin:0;padding:0;background-color:#eaf0f8;color:#152b49;font-family:Arial,Helvetica,sans-serif">
<div style="display:none;font-size:1px;line-height:1px;color:#eaf0f8;max-height:0;max-width:0;opacity:0;overflow:hidden"><%= reset ? "Reset your password securely." : "Verify your email and take your next step with Mobility Exchange." %></div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" bgcolor="#eaf0f8"><tr><td class="email-shell" align="center" style="padding:36px 12px">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background-color:#ffffff;border:1px solid #dce5f0;border-radius:16px;overflow:hidden">
<tr><td align="center" bgcolor="#ffffff" style="padding:16px 24px"><a href="<%= root_url %>" style="text-decoration:none"><img src="<%= root_url %>design/mobility-exchange-logo.jpg" width="220" alt="Mobility Exchange" style="display:block;width:220px;max-width:100%;height:auto;border:0"></a></td></tr>
<% unless reset %>
<tr><td bgcolor="#152b49"><img src="<%= root_url %>design/mobility-exchange-email-cover.png" width="600" alt="More independence. More possibilities. An older Indian couple beside the San Francisco Bay, with mobility equipment." style="display:block;width:100%;max-width:600px;height:auto;border:0;color:#ffffff;font-size:16px"></td></tr>
<% end %>
<tr><td height="5" bgcolor="#c1f346" style="height:5px;font-size:0;line-height:0">&nbsp;</td></tr>
<tr><td class="email-content" style="padding:36px 36px 32px">
<p style="margin:0 0 12px;color:#315ec0;font-size:12px;font-weight:bold;letter-spacing:1.5px;text-transform:uppercase"><%= reset ? "Account security" : "Together, we move forward" %></p>
<h1 class="email-title" style="margin:0 0 18px;color:#152b49;font-size:32px;line-height:1.2;letter-spacing:-0.5px"><%= heading %></h1>
<p style="margin:0 0 26px;color:#465b73;font-size:16px;line-height:1.65"><%= description %></p>
<table role="presentation" cellspacing="0" cellpadding="0"><tr><td bgcolor="#2559d6" style="border-radius:8px;text-align:center"><a href="<%= target %>" style="display:inline-block;padding:16px 26px;border:1px solid #2559d6;border-radius:8px;color:#ffffff;text-decoration:none;font-size:16px;font-weight:bold;line-height:1.3"><%= reset ? "Reset my password" : "Verify my email" %></a></td></tr></table>
<p style="margin:18px 0 28px;font-size:13px;line-height:1.5;color:#617187">For your security, this link expires in <strong><%= reset ? "30 minutes" : "24 hours" %></strong>.</p>
<% if @kind == "verification" %>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" bgcolor="#f1f6fc" style="border-radius:10px"><tr><td style="padding:20px"><p style="margin:0 0 8px;font-size:16px;font-weight:bold;color:#152b49">Your next chapter starts here.</p><p style="margin:0;font-size:14px;line-height:1.65;color:#465b73">Donate equipment. Volunteer your time. Find mobility support.<br>Make a difference in the Bay Area community.</p></td></tr></table>
<% end %>
<p style="margin:26px 0 8px;font-size:12px;line-height:1.6;color:#617187">Button not working? Copy and paste this link into your browser:</p>
<p style="margin:0;font-size:12px;line-height:1.6;word-break:break-all;overflow-wrap:anywhere"><a href="<%= target %>" style="color:#2559d6;text-decoration:underline"><%= target %></a></p>
<p style="margin:24px 0 0;font-size:12px;line-height:1.6;color:#617187">If you didn't request this email, you can safely ignore it.</p>
</td></tr>
<tr><td align="center" bgcolor="#152b49" style="padding:24px;color:#ffffff"><p style="margin:0 0 8px;font-size:15px;font-weight:bold">More independence. More possibilities.</p><p style="margin:0;font-size:12px;line-height:1.6;color:#dce7f5">Mobility Exchange · Serving the Bay Area, California</p></td></tr>
</table>
</td></tr></table></body></html>
