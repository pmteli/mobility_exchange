<!DOCTYPE html>
<html lang="en"><body style="margin:0;background:#f3f6fb;font-family:Arial,sans-serif;color:#15233d">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td style="padding:32px 16px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:auto;background:white;border-radius:16px"><tr><td style="padding:32px">
<p style="font-weight:bold;color:#2559d6">MOBILITY EXCHANGE</p>
<h1 style="font-size:26px"><%= @kind == "reset" ? "Reset your password." : "Verify your email address." %></h1>
<% target = @kind == "email_change" ? profile_email_url(@token) : (@kind == "verification" ? verification_url(@token) : edit_password_reset_url(@token)) %>
<p><%= @kind == "email_change" ? "Confirm your new email address. Your current sign-in email stays active until you confirm." : (@kind == "verification" ? "Verify your email address to activate your account." : "Use the link below to choose a new password.") %></p>
<p style="margin:28px 0"><%= link_to(@kind == "reset" ? "Reset password" : "Verify email address", target, style: "display:inline-block;padding:14px 22px;background:#2559d6;color:white;text-decoration:none;border-radius:8px;font-weight:bold") %></p>
<p>This link expires after <%= @kind == "reset" ? "30 minutes" : "24 hours" %>.</p>
<p style="font-size:14px;color:#526078">If you did not request this email, you can ignore it.</p>
<p style="font-size:12px;overflow-wrap:anywhere">If the button does not work, copy this link into your browser:<br><%= target %></p>
</td></tr></table></td></tr></table></body></html>
