<section class="panel"><h2><%= title %></h2><% if signed_records.any? %><p>Your signed documents:</p><ul><% signed_records.each do |signed| %><li><%= link_to "Download signed PDF · #{local_time(signed.signed_at)}", document_path(signed.signed_pdf_file_id) %></li><% end %></ul><% end %><% if legal && !%w[completed cancelled rejected].include?(record.status) && signed_records.empty? %><p class="muted">Version <%= legal.version %> · Review the complete text before signing.</p><div class="legal" tabindex="0" role="region" aria-label="Document text"><%= legal.exact_text %></div><%= form_with url: action do |f| %><%= f.hidden_field :version_id, value: legal.id %><div class="field"><%= f.label :signature, "Your full name (electronic signature)" %><%= f.text_field :signature, required: true, minlength: 2, maxlength: 150, autocomplete: "name" %></div><p><label><%= f.check_box :consent, required: true %><%= SignDocument::CONSENT %></label></p><p class="form-note">This form supports signing for yourself. Contact the team if an authorized representative must sign.</p><%= f.submit "Sign and save document" %><% end %><% elsif legal.nil? %><p>The team is preparing the required document. Please check back before scheduling.</p><% end %></section>
