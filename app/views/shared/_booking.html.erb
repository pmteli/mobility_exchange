<section class="panel"><h2><%= title %></h2><% booking = Appointment.where(record.is_a?(EquipmentRequest) ? { request_id: record.id } : { intake_id: record.id }).where(status: %w[booked completed]).first %><% if booking %><% slot = AppointmentSlot.find(booking.slot_id) %><p><%= local_time(slot.starts_at, slot.location.timezone) %> at <%= slot.location.name %></p><%= status_badge(booking.status) %><% elsif record.status == "approved" %><% if slots.any? %><%= form_with url: action do |f| %><div class="field"><%= f.label :slot_id, "Available appointments" %><%= f.select :slot_id, slots.map { |slot| ["#{local_time(slot.starts_at, slot.location.timezone)} · #{slot.location.name}", slot.id] }, prompt: "Choose a time" %></div><%= f.submit "Book appointment" %><% end %><% else %><p>No appointment times are available yet. Check back after the team has arranged your equipment.</p><% end %><% else %><p>Appointment booking becomes available after approval and signing.</p><% end %></section>
