<div class="identity-details two-col"><div><span>Full name</span><p><%= current_user.name %></p></div><div><span>Email address</span><p><%= current_user.email %></p></div></div>
<fieldset><legend>Contact details</legend><div class="field"><%= label_tag "contact_phone", "Phone" %><%= telephone_field_tag "contact[phone]", current_user.phone, autocomplete: "tel", maxlength: 50 %></div><div class="two-col"><div class="field"><%= label_tag "contact_city", "City" %><%= text_field_tag "contact[city]", current_user.city, autocomplete: "address-level2", maxlength: 100 %></div><div class="field"><%= label_tag "contact_region", "State / region" %><%= text_field_tag "contact[region]", current_user.region, autocomplete: "address-level1", maxlength: 100 %></div></div><div class="field"><%= label_tag "contact_postal_code", "Postal code" %><%= text_field_tag "contact[postal_code]", current_user.postal_code, autocomplete: "postal-code", maxlength: 20 %></div></fieldset>
