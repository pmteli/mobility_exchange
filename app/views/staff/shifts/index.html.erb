<section class="page"><div class="section-head"><h1>Volunteer shifts</h1><%= link_to "Create shift", new_staff_shift_path, class: "button" %></div><div class="grid"><% @shifts.each do |record| %><div class="card"><h3><%= record.activity.humanize %></h3><p><%= record.location.name %></p><p><%= local_time(record.starts_at, record.location.timezone) %></p><p>Capacity: <%= record.capacity %></p><% if record.cancelled_at %><%= status_badge("cancelled") %><% else %><%= button_to "Cancel shift", staff_shift_path(record), method: :patch %><% end %></div><% end %></div></section>
