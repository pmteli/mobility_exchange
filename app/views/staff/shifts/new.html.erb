<section class="page narrow"><h1>Create shift</h1><div class="panel"><%= form_with scope: :schedule, url: staff_shifts_path do |f| %><div class="field"><%= f.label :activity %><%= f.text_field :activity, required: true, maxlength: 200 %></div><div class="field"><%= f.label :location_id %><%= f.collection_select :location_id, Location.where(status: "active"), :id, :name %></div><p class="form-note">Enter times in UTC. Published times display in the location's timezone.</p><div class="field"><%= f.label :starts_at, "Starts at (UTC)" %><%= f.datetime_local_field :starts_at, required: true %></div><div class="field"><%= f.label :ends_at, "Ends at (UTC)" %><%= f.datetime_local_field :ends_at, required: true %></div><div class="field"><%= f.label :capacity %><%= f.number_field :capacity, min: 1, required: true %></div><%= f.submit "Create shift" %><% end %></div></section>
