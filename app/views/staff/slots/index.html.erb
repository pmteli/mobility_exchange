<section class="page"><div class="section-head"><h1>Appointment slots</h1><%= link_to "Create slot", new_staff_slot_path, class: "button" %></div><div class="grid"><% @slots.each do |record| %><div class="card"><h3><%= record.kind.humanize %></h3><p><%= record.location.name %></p><p><%= local_time(record.starts_at, record.location.timezone) %></p><p>Capacity: <%= record.capacity %></p><% if record.cancelled_at %><%= status_badge("cancelled") %><% else %><%= button_to "Cancel slot", staff_slot_path(record), method: :patch %><% end %></div><% end %></div></section>
