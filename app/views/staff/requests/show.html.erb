<section class="page narrow"><h1><%= @equipment_request.reference_number %></h1><%= status_badge(@equipment_request.status) %><div class="panel"><h2>Requested equipment</h2><% @equipment_request.request_items.includes(:equipment).each do |line| %><p><%= line.equipment.name %> · <%= line.equipment.inventory_number %></p><% end %><% if allowed?("recipients.read") %><h3>Recipient</h3><p><%= @equipment_request.recipient.first_name %> <%= @equipment_request.recipient.last_name %><br><%= @equipment_request.recipient.phone %></p><% end %><p>Signed waiver: <%= @equipment_request.signed_waivers.exists? ? "On file" : "Pending" %></p></div><%= render "staff/shared/review", record: @equipment_request, action: staff_request_path(@equipment_request) %><% if @equipment_request.status == "approved" %><%= button_to "Reserve available equipment", reserve_staff_request_path(@equipment_request) %><% end %><% @equipment_request.reservations.includes(:equipment).each do |reservation| %><div class="panel"><h3><%= reservation.equipment.name %></h3><%= status_badge(reservation.status) %><% if reservation.status == "active" %><h3>Complete pickup</h3><%= form_with url: release_staff_request_path(@equipment_request) do |f| %><%= f.hidden_field :reservation_id, value: reservation.id %><div class="field"><%= f.label :signature, "Recipient's full name as pickup signature" %><%= f.text_field :signature, required: true, maxlength: 150 %></div><div class="field"><%= f.label :condition, "Equipment condition at pickup" %><%= f.text_field :condition, required: true, maxlength: 1000 %></div><p class="form-note">Capture the recipient's signature at handover. A signed waiver and booked pickup are required.</p><%= f.submit "Confirm handover" %><% end %><div class="actions"><%= button_to "Cancel reservation", cancel_reservation_staff_request_path(@equipment_request), params: { reservation_id: reservation.id }, class: "text-button" %></div><% end %></div><% end %></section>
