<section class="page"><div class="section-head"><div><p class="eyebrow">Operations overview</p><h1>A little care. A lasting difference.</h1><p>Welcome back, <%= current_user.first_name %>. Keep every equipment journey moving.</p></div><%= link_to "View inventory →", staff_equipment_index_path, class: "button" if allowed?("inventory.read") %></div>
<div class="metrics-grid"><% [["available", "Ready to share", "box"], ["received", "New arrivals", "heart"], ["reserved", "Awaiting pickup", "calendar"], ["distributed", "New chapters started", "people"]].each_with_index do |(status, label, icon), index| %><article class="metric-card <%= 'featured' if index.zero? %>"><div class="metric-top"><p><%= label %></p><%= design_icon(icon) %></div><strong><%= @totals.fetch(status, 0) %></strong><span><%= status.humanize %></span></article><% end %></div>
<div class="two-col dashboard-panels"><section class="panel"><div class="card-heading"><div><p class="eyebrow">From intake to independence</p><h2>The equipment journey</h2></div><%= design_icon("leaf") %></div><% @totals.sort.each do |status, count| %><div class="status-row"><%= status_badge(status) %><strong><%= count %></strong><%= link_to "View →", staff_equipment_index_path(status: status), class: "text-link" %></div><% end %><% if @totals.empty? %><p class="muted">Your summary will appear as equipment is received.</p><% end %></section><section class="panel"><p class="eyebrow">Make the next handoff happen</p><h2>Your workspace</h2><div class="quick-links"><% operations_links.reject { |label, _, _, _| label == "Overview" }.first(5).each do |label, path, icon, _| %><%= link_to path do %><span class="journey-icon"><%= design_icon(icon) %></span><strong><%= label %></strong><%= design_icon("arrow") %><% end %><% end %></div></section></div></section>
