<section class="page"><div class="section-head"><h1>Equipment inventory</h1><%= link_to "Receive legacy equipment", new_staff_equipment_path, class: "button" if allowed?("inventory.write") %></div><div class="table-scroll" role="region" aria-label="Scrollable records" tabindex="0"><table class="data-table"><thead><tr><th>Equipment</th><th>Status</th><th>Location</th><th>Received</th></tr></thead><tbody><% @equipment.each do |item| %><tr><td><%= link_to item.name, staff_equipment_path(item) %><br><small><%= item.inventory_number %></small></td><td><%= status_badge(item.status_code) %></td><td><%= item.location.name %></td><td><%= local_time(item.received_at) %></td></tr><% end %></tbody></table></div><p class="form-note">Showing the most recent 100 matching records.</p></section>
