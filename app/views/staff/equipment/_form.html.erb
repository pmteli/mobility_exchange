<%= form_with model: @equipment, url: @equipment.persisted? ? staff_equipment_path(@equipment) : staff_equipment_index_path do |f| %><div class="field"><%= f.label :name %><%= f.text_field :name, required: true, maxlength: 200 %></div><div class="two-col"><div class="field"><%= f.label :type_id, "Equipment type" %><%= f.collection_select :type_id, EquipmentType.where(active: true).order(:name), :id, :name %></div><div class="field"><%= f.label :location_id %><%= f.collection_select :location_id, Location.where(status: "active").order(:name), :id, :name %></div></div><div class="field"><%= f.label :condition %><%= f.select :condition, %w[new excellent good fair poor unknown] %></div><% [:manufacturer, :model, :serial_number, :storage_position].each do |attribute| %><div class="field"><%= f.label attribute %><%= f.text_field attribute, maxlength: 200 %></div><% end %><div class="field"><%= f.label :description, "Public description" %><%= f.text_area :description, maxlength: 3000 %></div><div class="field"><%= f.label :public_notes %><%= f.text_area :public_notes, maxlength: 3000 %></div><%= f.submit "Save equipment" %><% end %>
