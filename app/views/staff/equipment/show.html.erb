<section class="page"><div class="section-head"><div><p class="eyebrow"><%= @equipment.inventory_number %></p><h1><%= @equipment.name %></h1></div><%= status_badge(@equipment.status_code) %></div><div class="two-col"><div class="panel"><h2>Equipment details</h2><p><%= @equipment.description %></p><p><strong>Location:</strong> <%= @equipment.location.name %></p><p><strong>Condition:</strong> <%= @equipment.condition.humanize %></p><%= link_to "Edit details", edit_staff_equipment_path(@equipment), class: "button secondary" if allowed?("inventory.write") %></div><% if allowed?("inventory.process") && @transitions.any? %><div class="panel"><h2>Record next step</h2><%= form_with url: process_item_staff_equipment_path(@equipment) do |f| %><div class="field"><%= f.label :target, "Move to" %><%= f.select :target, @transitions.map { |s| [s.humanize, s] } %></div><div class="field"><%= f.label :notes, "Work performed / findings" %><%= f.text_area :notes, required: true, maxlength: 3000 %></div><%= f.submit "Record processing step" %><% end %></div><% end %></div><h2>Processing history</h2><% @equipment.processing_events.order(performed_at: :desc).each do |event| %><div class="panel"><%= status_badge(event.outcome) %><h3><%= event.kind.humanize %></h3><p><%= event.notes %></p><p class="muted"><%= local_time(event.performed_at) %></p></div><% end %></section>
