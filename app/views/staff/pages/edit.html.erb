<section class="page narrow"><h1>Edit page</h1><div class="panel"><%= form_with model: @page, url: staff_page_path(@page) do |f| %><div class="field"><%= f.label :title %><%= f.text_field :title, required: true %></div><div class="field"><%= f.label :body_markdown, "Page text (plain text)" %><%= f.text_area :body_markdown, rows: 15, required: true %></div><p><label><%= check_box_tag :publish, "1", @page.published_at.present? %> Publish page</label></p><%= f.submit "Save page" %><% end %></div></section>
