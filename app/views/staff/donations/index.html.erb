<section class="page"><h1>Donations</h1><div class="table-scroll" role="region" aria-label="Scrollable records" tabindex="0"><table class="data-table"><thead><tr><th>Reference</th><th>Status</th><th>Submitted</th></tr></thead><tbody><% @donations.each do |record| %><tr><td><%= link_to record.reference_number, staff_donation_path(record) %></td><td><%= status_badge(record.status) %></td><td><%= local_time(record.submitted_at) %></td></tr><% end %></tbody></table></div><p class="form-note">Showing the most recent 100 records.</p></section>
