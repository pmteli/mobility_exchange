<section class="page narrow"><h1><%= @donation.reference_number %></h1><%= status_badge(@donation.status) %><% if allowed?("donors.read") %><div class="panel"><h2>Donor</h2><p><%= @donation.donor.first_name %> <%= @donation.donor.last_name %><br><%= @donation.donor.phone %></p></div><% end %><%= render "staff/shared/review", record: @donation, action: staff_donation_path(@donation) %><% @donation.intake_items.each do |item| %><div class="panel"><h2><%= item.name %></h2><p><%= item.quantity %> offered · <%= item.condition %></p><p><%= item.description %></p><p>Received: <%= Equipment.where(intake_item_id: item.id).count %></p><p>Certification: <%= @donation.signed_donor_certifications.exists? ? "On file" : "Pending" %></p><% if allowed?("inventory.write") && %w[approved scheduled received].include?(@donation.status) %><%= form_with url: receive_item_staff_donation_path(@donation) do |f| %><%= f.hidden_field :item_id, value: item.id %><div class="field"><%= f.label :location_id, "Receiving location" %><%= f.collection_select :location_id, Location.where(status: "active"), :id, :name %></div><%= f.submit "Receive one unit" %><% end %><% end %></div><% end %></section>
