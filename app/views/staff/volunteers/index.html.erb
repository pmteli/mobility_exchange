<section class="page"><h1>Volunteer applications</h1><div class="grid"><% @volunteers.each do |volunteer| %><div class="card"><h3><%= volunteer.user.name %></h3><%= status_badge(volunteer.approval_status) %><p><%= volunteer.skills %></p><%= form_with url: staff_volunteer_path(volunteer.user_id), method: :patch do |f| %><div class="field"><%= f.label :status, "Decision for #{volunteer.user.name}" %><%= f.select :status, %w[approved rejected inactive], selected: volunteer.approval_status %></div><%= f.submit "Save decision" %><% end %></div><% end %></div></section>
