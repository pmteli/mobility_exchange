<% if %w[submitted under_review].include?(record.status) %><div class="panel"><h2>Review submission</h2><%= form_with url: action, method: :patch do |f| %><div class="field"><%= f.label :status, "Decision" %><%= f.select :status, [["Approve", "approved"], ["Reject", "rejected"]] %></div><div class="field"><%= f.label :reason, "Reason (required for rejection)" %><%= f.text_area :reason, maxlength: 2000 %></div><%= f.submit "Save review" %><% end %></div><% end %>
