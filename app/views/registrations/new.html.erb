<section class="auth-layout">
<aside class="auth-art login-welcome signup-welcome" aria-labelledby="signup-welcome-title">
  <p class="eyebrow">Mobility Exchange · Bay Area</p>
  <h2 id="signup-welcome-title">Join our community.<br><span>Open up new possibilities.</span></h2>
  <p class="login-welcome-copy">Donate equipment, volunteer your time, or find the mobility support you need. Your account connects you with a community that cares.</p>
  <p class="login-welcome-purpose">Give a little. Connect with others.<br><strong>Help independence grow.</strong></p>
</aside><div class="auth-form"><p class="eyebrow">Join the exchange</p><h1>Start with an account.</h1>
<% if @signup_errors.present? %>
<div id="signup-errors" class="signup-error-summary" role="alert" tabindex="-1">
<p><strong>Please correct the following:</strong></p>
<ul><% @signup_errors.each do |message| %><li><%= message %></li><% end %></ul>
<p>Please re-enter your password and confirmation.</p>
</div>
<% end %>
<p class="lede">Request equipment, track donations, and get involved.</p><div class="panel"><%= form_with url: registration_path do |f| %><div class="two-col"><div class="field"><%= f.label :first_name %><%= f.text_field :first_name, value: params[:first_name], required: true, maxlength: 100, autocomplete: "given-name" %></div><div class="field"><%= f.label :last_name %><%= f.text_field :last_name, value: params[:last_name], required: true, maxlength: 100, autocomplete: "family-name" %></div></div><div class="field"><%= f.label :email %><%= f.email_field :email, value: params[:email], required: true, autocomplete: "email" %></div><div class="field"><%= f.label :password, "Password (at least 8 characters)" %><%= f.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password" %></div><div class="field"><%= f.label :password_confirmation %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div><fieldset class="signup-roles"><legend>How would you like to participate?</legend><p class="muted">Select one or more roles.</p><label><%= check_box_tag "community_roles[]", "volunteer", Array(params[:community_roles]).include?("volunteer"), id: "role_volunteer" %> Volunteer</label><label><%= check_box_tag "community_roles[]", "donor", Array(params[:community_roles]).include?("donor"), id: "role_donor" %> Donor</label><label><%= check_box_tag "community_roles[]", "recipient", Array(params[:community_roles]).include?("recipient"), id: "role_recipient" %> Recipient</label></fieldset><%= f.submit "Create account" %><% end %></div></div></section>
