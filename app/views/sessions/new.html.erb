<section class="auth-layout">
<aside class="auth-art login-welcome" aria-labelledby="login-welcome-title">
  <p class="eyebrow">Mobility Exchange · Bay Area</p>
  <h2 id="login-welcome-title">More independence.<br><span>Made possible together.</span></h2>
  <p class="login-welcome-copy">Welcome to a community that helps mobility equipment find a new purpose—and people find greater independence.</p>
  <p class="login-welcome-purpose">Give equipment. Find support.<br><strong>Make a difference.</strong></p>
</aside><div class="auth-form"><p class="eyebrow">Your Mobility Exchange</p><h1>Welcome back.</h1><div class="panel"><%= form_with url: session_path do |f| %><div class="field"><%= f.label :email %><%= f.email_field :email, required: true, autocomplete: "username" %></div><div class="field"><%= f.label :password %><%= f.password_field :password, required: true, autocomplete: "current-password" %></div><%= f.submit "Sign in" %><% end %></div><p><%= link_to "Create an account", new_registration_path %> · <%= link_to "Forgot password?", new_password_reset_path %></p><p><%= link_to "Resend verification email", new_verification_request_path %></p></div></section>
