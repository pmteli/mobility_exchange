<% content_for :title, "#{@item.name} | Mobility Exchange" %>
<section class="page"><%= link_to "← Available equipment", catalogue_path, class: "text-link" %><div class="detail-grid"><div class="detail-art equipment-art"><%= status_badge("available") %><%= equipment_illustration(@item.category, @item.equipment_type) %><span class="illustration-label">Illustration · not a product photo</span></div><div class="detail-copy"><p class="eyebrow"><%= @item.category %></p><h1><%= @item.name %></h1><p class="lede"><%= @item.description %></p><dl class="metadata"><% {"Type" => @item.equipment_type, "Condition" => @item.condition.humanize, "Pickup location" => @item.pickup_location, "Inventory number" => @item.inventory_number, "Manufacturer" => @item.manufacturer, "Model" => @item.model}.each do |label, value| %><% if value.present? %><div><dt><%= label %></dt><dd><%= value %></dd></div><% end %><% end %></dl><p><%= @item.public_notes %></p><div class="actions"><%= link_to new_equipment_request_path(equipment_id: @item.id), class: "button" do %>Request this equipment <%= design_icon("arrow") %><% end %></div><div class="notice"><%= design_icon("shield") %><p>Submitting a request does not reserve this item. Our team will confirm availability and help arrange pickup.</p></div></div></div></section>
