<% home = request.path == root_path && params[:q].blank? && params[:category].blank? && params[:page].blank? %>
<% content_for :title, home ? "More possibilities | Mobility Exchange" : "Available equipment | Mobility Exchange" %>
<% if home %>
<div class="exchange-container">
<section class="exchange-hero" aria-labelledby="home-hero-title">
  <div class="exchange-hero-body">
    <p class="exchange-eyebrow">A Bay Area nonprofit initiative</p>
    <h1 id="home-hero-title"><span><em>Free,</em> gently used</span> <span>home medical</span> <span>equipment.</span></h1>
    <p class="exchange-hero-description">Connecting donated equipment with Bay Area neighbors who need it.</p>
    <div class="exchange-hero-actions">
      <%= link_to new_donation_path, class: "exchange-action exchange-action-primary" do %>Donate equipment <span aria-hidden="true">→</span><% end %>
      <%= link_to catalogue_path, class: "exchange-action exchange-action-secondary" do %>Find Equipment <span aria-hidden="true">→</span><% end %>
    </div>
    <p class="exchange-tagline"><span>More independence.</span> <span>More possibilities.</span></p>
  </div>
  <div class="exchange-hero-art" role="img" aria-label="An illustration of a man using a wheelchair beside a woman, overlooking San Francisco Bay and the Golden Gate Bridge.">
    <svg viewBox="1320 122 683 602" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><image href="/design/homepage-reference-art.png" width="2048" height="1005"/></svg>
  </div>
</section>
</div>
<div class="container"><div class="journey-ribbon" aria-label="Our equipment preparation process"><% [["Collect", "heart"], ["Inspect", "shield"], ["Sanitize", "sparkles"], ["Redistribute", "box"]].each_with_index do |(label, icon), index| %><div><span class="journey-icon"><%= design_icon(icon) %></span><span><small>0<%= index + 1 %></small><strong><%= label %></strong></span><%= design_icon("arrow") unless index == 3 %></div><% end %></div></div>
<% else %>
<div class="container page-intro"><p class="eyebrow">Support for your next step</p><h1>Find a little support.<br>A new possibility.</h1><p>Explore equipment ready for its next chapter. Our team confirms availability before arranging pickup.</p></div>
<% end %>
<div class="container"><section id="equipment" class="section catalog-section"><% if home %><div class="section-head"><div><p class="eyebrow">Support for your next step</p><h2><%= home ? "Useful equipment. A renewed purpose." : "Available equipment" %></h2><p>Thoughtfully prepared and ready to be shared.</p></div><% if home %><%= link_to catalogue_path, class: "text-link" do %>Browse all equipment <%= design_icon("arrow") %><% end %><% end %></div><% end %>
<% unless home %><%= form_with url: catalogue_path, method: :get, class: "filters" do |f| %><div class="field"><%= f.label :q, "Search equipment" %><div class="search-input"><%= design_icon("search") %><%= f.search_field :q, value: params[:q], placeholder: "Wheelchair, walker, shower chair…" %></div></div><div class="field"><%= f.label :category, "Category" %><%= f.select :category, options_for_select(@categories.map { |c| [c.name, c.name] }, params[:category]), include_blank: "All categories" %></div><%= f.submit "Find equipment" %><% end %><p class="results-line">Showing <%= pluralize(@items.size, "item") %> on page <%= @page %></p><% end %>
<div class="grid"><%= render partial: "card", collection: home ? @items.first(3) : @items, as: :item %></div>
<% if @items.empty? %><div class="empty"><%= design_icon("leaf") %><h3>Our catalog is getting ready.</h3><p>No equipment matches this search. Try another category or check back soon.</p><%= link_to "Clear filters", catalogue_path, class: "text-link" %></div><% end %>
<% unless home %><div class="pagination"><span><%= link_to "← Previous", catalogue_path(q: params[:q], category: params[:category], page: @page - 1) if @page > 1 %></span><span><%= link_to "Next →", catalogue_path(q: params[:q], category: params[:category], page: @page + 1) if @items.size == 24 %></span></div><% end %>
</section>
<% if home %><section class="section ways-section"><div class="section-head"><div><p class="eyebrow">One community. Many ways to help.</p><h2>A small act. A meaningful difference.</h2></div></div><div class="grid"><% [["heart", "Give equipment a second story.", "Donate equipment you no longer need. Share the details and let the next chapter begin.", "Start a donation", new_donation_path], ["box", "Find support for daily life.", "Browse available equipment, send a request, and arrange pickup after the team confirms your reservation.", "Explore equipment", catalogue_path], ["people", "Bring your time and talents.", "Help prepare equipment and support your community through a volunteer shift.", "Get involved", new_volunteer_application_path]].each do |icon, title, body, label, path| %><article class="way-card"><span class="way-icon"><%= design_icon(icon) %></span><h3><%= title %></h3><p><%= body %></p><%= link_to path, class: "text-link" do %><%= label %> <%= design_icon("arrow") %><% end %></article><% end %></div></section><section class="partner-panel"><div><p class="eyebrow">Healthcare & community partners</p><h2>Good work goes further together.</h2><p>Connect with our team about equipment, volunteering, or supporting a thoughtful handoff.</p><%= link_to page_path("contact"), class: "button light" do %>Connect with the team <%= design_icon("arrow") %><% end %></div><div class="partner-note"><%= design_icon("heart") %><p>A second life for equipment.<br>A new possibility for someone.</p><span>Our shared purpose</span></div></section><% end %>
</div>
