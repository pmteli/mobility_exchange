<section class="container page-intro"><h1><%= @existing ? "Connect your account" : "Welcome to Mobility Exchange" %></h1>
<% if @errors.present? %><div class="signup-error-summary" role="alert"><ul><% @errors.each do |error| %><li><%= error %></li><% end %></ul></div><% end %>
<p>Google verified your email: <strong><%= @identity.fetch("email") %></strong></p>
<div class="panel"><%= form_with url: google_registration_path do |f| %>
<% if @existing %>
<p>An account already uses this email. Enter your Mobility Exchange password to securely connect Google. Do not enter your Google password.</p>
<div class="field"><%= f.label :password, "Mobility Exchange password" %><%= f.password_field :password, required: true, autocomplete: "current-password" %></div>
<p><%= link_to "Forgot your password?", new_password_reset_path %> · <%= link_to "Resend verification email", new_verification_request_path %></p>
<% else %>
<div class="two-col"><% [:first_name, :last_name].each do |field| %><div class="field"><%= f.label field %><%= f.text_field field, value: params[field] || @identity[field.to_s], required: true, maxlength: 100, autocomplete: field == :first_name ? "given-name" : "family-name" %></div><% end %></div>
<fieldset class="signup-roles"><legend>How would you like to participate?</legend><p>Select one or more roles. Volunteers still need approval before joining shifts.</p>
<% %w[donor volunteer recipient].each do |role| %><label><%= check_box_tag "community_roles[]", role, Array(params[:community_roles]).include?(role), id: "role_#{role}" %> <%= role.capitalize %></label><% end %></fieldset>
<p>You can also set a password later using the password-reset link on the sign-in page.</p>
<% end %>
<%= f.submit(@existing ? "Connect Google and sign in" : "Create account") %>
<% end %></div><p><%= link_to "Return to sign in", new_session_path %></p></section>
