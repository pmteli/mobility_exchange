<section class="auth-layout">
<%= render "design/auth_art" %><div class="auth-form"><h1>Reset your password.</h1><div class="panel"><%= form_with url: password_resets_path do |f| %><div class="field"><%= f.label :email %><%= f.email_field :email, required: true, autocomplete: "email" %></div><%= f.submit "Send reset link" %><% end %></div></div></section>
