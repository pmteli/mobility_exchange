<header><a href="/" class="brand" aria-label="FreeDME.org home"><img class="brand-symbol" src="/prototype-assets/community-care-logo.png" alt="" aria-hidden="true"><svg class="brand-wordmark" viewBox="490 158 1510 270" role="img" aria-label="FreeDME.org"><image href="/prototype-assets/logo.png" width="2048" height="682.667"/></svg></a><button type="button" class="mobile-menu-toggle" aria-expanded="false" aria-controls="main-navigation">☰ Menu</button><nav id="main-navigation" aria-label="Main navigation"><%= main_navigation_link "Find Equipment", "/equipment", :equipment %><%= main_navigation_link "Donate Equipment", "/donate", :donate %><%= main_navigation_link "How it works", "/how-it-works", :how %><%= main_navigation_link "Resources & help", "/resources", :resources %><%= main_navigation_link "My Activity", "/activity", :activity %><% if current_account %><%= button_to sign_out_path, method: :delete, class: "auth-button auth-sign-out" do %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5H5v14h4M9 12h12m-4-4 4 4-4 4"/></svg><span>Sign Out</span><% end %><% else %><%= link_to sign_in_path, aria: { current: navigation_section == :signin ? "page" : nil }, class: "button-link primary auth-button auth-sign-in" do %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5h4v14h-4M3 12h12m-4-4 4 4-4 4"/></svg><span>Sign In</span><% end %><% end %></nav></header>