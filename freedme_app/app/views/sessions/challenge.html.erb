<div class="reading"><% if Integrations::TwilioClient.live? %><h1>Verify your code</h1><p>Enter the six-digit code sent to your mobile number.</p><% else %><h1>Verify your simulated code</h1><p>Open the <%= link_to "local simulated SMS inbox", test_data_path, target: "_blank" %> in another tab and enter the latest code for your number. Never use real OTPs here.</p><% end %>
<%= form_with url: verify_sign_in_path, class: "journey-form" do |f| %><%= f.label :code, "Six-digit code" %><%= f.text_field :code, inputmode: "numeric", pattern: "[0-9]{6}", maxlength: 6, autocomplete: "one-time-code", required: true %><%= f.button "Verify and sign in", class: "primary" %><% end %>
<%= link_to "Request another code", session.dig(:pending_login, "registration") ? register_path : sign_in_path %></div>
