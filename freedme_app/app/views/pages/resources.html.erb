<div class="donor-tabs journey-tabs" data-tab-memory="resources-tabs" role="tablist" aria-label="<%= t('resources.tabs_label') %>">
  <button type="button" role="tab" id="tab-help" aria-controls="panel-help" aria-selected="true" tabindex="0" data-action="journey-tab"><%= t("resources.help_tab") %></button>
  <button type="button" role="tab" id="tab-faq" aria-controls="panel-faq" aria-selected="false" tabindex="-1" data-action="journey-tab"><%= t("resources.faq_tab") %></button>
  <button type="button" role="tab" id="tab-mission" aria-controls="panel-mission" aria-selected="false" tabindex="-1" data-action="journey-tab"><%= t("resources.mission_tab") %></button>
  <button type="button" role="tab" id="tab-team" aria-controls="panel-team" aria-selected="false" tabindex="-1" data-action="journey-tab"><%= t("resources.team_tab") %></button>
</div>
<section role="tabpanel" id="panel-help" aria-labelledby="tab-help">

<%= render "resource_help" %></section>
<section role="tabpanel" id="panel-faq" aria-labelledby="tab-faq" hidden>
  <div class="reading">
    <h2><%= t("resources.faq_tab") %></h2>
    <p><%= t("resources.faq_intro") %></p>
    <% t("resources.faqs").each_key do |key| %>
      <details class="panel" id="faq-<%= key %>">
        <summary><%= t("resources.faqs.#{key}.question") %></summary>
        <p><%= t("resources.faqs.#{key}.answer", website: "https://www.freedme.org") %></p>
      </details>
    <% end %>
  </div>
</section>
<section role="tabpanel" id="panel-mission" aria-labelledby="tab-mission" hidden>
<section id="mission-statement" aria-labelledby="mission-title">
  <h2 id="mission-title"><%= t("resources.mission.title") %></h2>
  <p><%= t("resources.mission.statement") %></p>
  <p><%= t("resources.mission.description") %></p>
</section>
</section>
<section role="tabpanel" id="panel-team" aria-labelledby="tab-team" hidden>
  <div class="reading">
    <h2><%= t("resources.team_tab") %></h2>
    <p><%= t("resources.team_intro") %></p>
    <div class="panel"><h3><%= t("resources.team_pending_title") %></h3><p><%= t("resources.team_pending_body") %></p></div>
  </div>
</section>
