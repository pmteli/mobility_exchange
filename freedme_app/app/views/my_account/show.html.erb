<p class="eyebrow">Your preferences</p><h1>My Account</h1>
<section class="panel"><h2>Account details</h2><p><strong>Display name:</strong> <%= current_account.display_name %></p><p><strong>Location:</strong> <%= current_account.public_locality %></p><% if @mobile %><p><strong>Mobile number:</strong> <%= @mobile %></p><%= link_to 'Change mobile number', account_mobile_path, class: 'button-link' %><% end %><% if Staff::Authentication.staff?(current_account) %><p>Staff sign-in: email or username, password and authenticator verification.</p><% unless @contact %><%= link_to "Add notification mobile number", staff_notification_mobile_path, class: "button-link" %><% end %><% end %></section>
<% if @contact %><section class="panel" id="sms-preferences"><h2>SMS Preferences</h2><p>Optional notifications are <strong><%= @sms_enabled ? 'ON' : 'OFF' %></strong>. Sign-in verification codes are separate from this preference.</p>
<%= form_with url: sms_preferences_path, method: :patch do %><%= render 'shared/sms_consent', selected: @sms_enabled %><div class="actions"><%= button_tag 'Save SMS preference', type: 'submit', class: 'button-link' %></div><% end %>
<p>If you previously replied STOP, contact <a href="mailto:inquiry@mobilityexchange.org">inquiry@mobilityexchange.org</a> to restore notifications.</p></section><% end %>
<section class="panel" id="privacy"><h2>Privacy &amp; Deletion</h2><p>Review how FreeDME uses your information or request deletion of your account and personal records.</p><div class="actions"><%= link_to 'Privacy Policy', privacy_policy_path, class: 'button-link' %><%= link_to 'Privacy & Deletion', privacy_controls_path, class: 'button-link' %></div></section>
<%= link_to 'Back to My Activity', activity_path, class: 'button-link' %>
