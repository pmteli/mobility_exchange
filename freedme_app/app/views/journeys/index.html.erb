<p class="eyebrow">My Activity</p><h1>Hello, <%= current_account.display_name %></h1>
<div class="actions"><%= link_to "Find Equipment", equipment_index_path, class: "button-link" %><% unless @roles == ["moderator"] %><%= link_to "Donate Equipment", new_listing_path, class: "button-link primary" %><% end %></div>
<div class="donor-tabs journey-tabs" data-tab-memory="activity-<%= current_account.id %>" role="tablist" aria-label="My Activity sections">
<% sections = @roles.include?("moderator") ? [["review","Listing Reviews"],["documents","Identity Documents"],["followups","Follow-up Tasks"],["messages","Simulated SMS"]] : [["inventory","My Equipment"],["requests","Requests & Handoffs"],["questions","Questions & Answers"],["messages","Simulated SMS"]] %>
<% sections.each_with_index do |(key,label),i| %><button type="button" role="tab" id="tab-<%= key %>" aria-controls="panel-<%= key %>" aria-selected="<%= i == 0 %>" tabindex="<%= i == 0 ? 0 : -1 %>" data-action="journey-tab"><%= label %></button><% end %></div>
<% sections.each_with_index do |(key,label),i| %><section class="panel" role="tabpanel" id="panel-<%= key %>" aria-labelledby="tab-<%= key %>" <%= 'hidden' unless i == 0 %>><h2><%= label %></h2>
<% case key; when "documents" %>
<p>Private document images are available for seven days after upload. Access is audited. Requesters confirm extracted details; OCR does not authenticate identity documents.</p>
<% @identity_uploads.each do |upload| %><article class="panel"><h3><%= upload.account.display_name %> — <%= ListingRevision.find(upload.revision_id).title %></h3><p><%= upload.state.humanize %> · Image deletion due <%= upload.purge_due_at %></p><% if upload.image_ciphertext && upload.purge_due_at > Time.current %><%= link_to 'View private document', identity_document_image_path(upload), class: 'button-link', target: '_blank', rel: 'noopener' %><% else %><p>Image deleted or unavailable.</p><% end %></article><% end %>
<% when "inventory" %>
<% if @listings.empty? %><p>No equipment added yet.</p><% end %>
<% @listings.each do |listing| %><% revision = revision_for(listing) %><article class="panel journey-card"><span class="badge"><%= listing.status.humanize.upcase %></span><h3><%= link_to revision.title, equipment_path(listing) %></h3>
<% if listing.status == 'unavailable' %><p>New requests are closed. Confirm availability to reopen.</p><%= form_with url: reopen_listing_path(listing) do |f| %><label class="check"><%= check_box_tag :confirmed, '1', false, required: true, id: "confirmed_#{listing.id}" %> I still have this equipment and it is available.</label><%= f.button "Make available again" %><% end %><% end %>
<% unless %w[reserved loaned donated].include?(listing.status) %><%= link_to "Edit Equipment", edit_listing_path(listing), class: "button-link" %><% end %></article><% end %>
<% when "requests" %>
<% if @exchanges.empty? %><p>No requests yet.</p><% end %>
<% @exchanges.each do |exchange| %><article class="panel journey-card"><span class="badge"><%= exchange.state.upcase %></span><h3><%= link_to ListingRevision.find(exchange.revision_id).title, equipment_path(exchange.listing_id) %></h3><p><%= exchange.donor_id == current_account.id ? donor_request_summary(exchange) : recipient_request_summary(exchange) %></p><div class="actions"><%= link_to "View transaction", transaction_path(exchange), class: "button-link primary" %>
<% if exchange.state == 'expired' && exchange.requester_id == current_account.id %><%= link_to "Request Again", new_equipment_request_path(exchange.listing_id, retry_id: exchange.id), class: "button-link" %><%= button_to "Remove Request", change_transaction_path(exchange), params: {event: "hide"} %><% end %></div></article><% end %>
<% when "questions" %>
<% if @questions.empty? %><p>No questions yet.</p><% end %>
<% @questions.each do |listing_id, questions| %><article class="panel journey-card"><h3><%= link_to revision_for(Listing.find(listing_id)).title, equipment_path(listing_id) %></h3>
<% questions.each do |question| %><div class="note"><span class="badge"><%= question.state.upcase %></span><p><strong>Question:</strong> <%= local_text(question.question_ciphertext) %></p>
<% if question.answer_ciphertext %><p><strong>Answer:</strong> <%= local_text(question.answer_ciphertext) %></p><% elsif question.donor_id == current_account.id %><details><summary class="button-link answer-button">Answer</summary><%= form_with url: answer_question_path(question), namespace: "answer_#{question.id}", class: "journey-form" do |f| %><%= f.label :answer, "Your answer" %><%= f.text_area :answer, required: true, maxlength: 2000 %><%= f.button "Submit answer", class: "primary" %><% end %></details><% end %></div><% end %>
<% if questions.first.requester_id == current_account.id %><%= link_to "Ask Another Question", equipment_path(listing_id, anchor: "ask-question"), class: "button-link" %><% end %></article><% end %>
<% when "review" %>
<% if @reviews.empty? %><p>No listings awaiting review.</p><% end %>
<% @reviews.each do |listing| %><% revision = revision_for(listing) %><article class="panel journey-card"><h3><%= link_to revision.title, equipment_path(listing) %></h3><p>Donor: <%= listing.donor.display_name %> · <%= revision.condition_description %></p><p><%= revision.description %></p>
<%= render "shared/equipment_gallery", revision_id: revision.id, title: revision.title %>
<% equipment_photos(revision.id).each do |photo| %><p class="note">Photo <%= photo.slot %> screening: <%= photo_screening_summary(photo, listing.donor_id) %></p><% end %>
<%= form_with url: review_listing_path(listing), namespace: "review_#{listing.id}", class: "journey-form" do |f| %><p>Review every photo for private information and inappropriate content before approving. Screening is a local simulation, not a safety certification or real recall review.</p><%= f.label :reason, "Review notes" %><%= f.text_area :reason, required: true, maxlength: 2000 %><div class="actions"><%= button_tag "Approve & publish (simulation)", name: "decision", value: "approve", class: "primary" %><%= button_tag "Reject", name: "decision", value: "reject" %></div><% end %></article><% end %>
<% when "followups" %>
<p>Created after seven days reserved without handoff confirmation. Record contacts and findings; resolution does not assert a physical transfer.</p>
<% if @tasks.empty? %><p>No follow-up tasks.</p><% end %>
<% @tasks.each do |task| %><article class="panel journey-card"><h3>Unconfirmed handoff</h3><span class="badge"><%= task.state.upcase %></span><% exchange = Exchange.find(task.exchange_id) %><p><%= ListingRevision.find(exchange.revision_id).title %> · Donor: <%= exchange.donor.display_name %> · Recipient: <%= exchange.requester.display_name %></p>
<% if %w[open in_progress].include?(task.state) %><%= form_with url: resolve_task_path(task), namespace: "task_#{task.id}", class: "journey-form" do |f| %><label class="check"><%= check_box_tag :donor_contacted, "1", false, id: "donor_contacted_#{task.id}" %> Donor contacted</label><label class="check"><%= check_box_tag :recipient_contacted, "1", false, id: "recipient_contacted_#{task.id}" %> Recipient contacted</label><%= f.label :outcome %><%= f.select :outcome, [['Reported handoff occurred','handoff_confirmed'],['Not handed off','not_handed_off'],['Unable to reach','unable_to_reach'],['Cancelled','cancelled']] %><%= f.label :notes %><%= f.text_area :notes, required: true %><%= f.button "Resolve follow-up" %><% end %><% else %><p>Outcome: <%= task.outcome&.humanize %></p><% end %></article><% end %>
<% when "messages" %>
<p>These messages are persisted locally. No messages are sent to a phone.</p><% @messages.each do |message| %><article class="panel journey-card"><span class="badge">SIMULATED</span><p><%= sms_message_body(message.body) %></p><small><%= message.created_at %></small></article><% end %>
<% end %></section><% end %>
