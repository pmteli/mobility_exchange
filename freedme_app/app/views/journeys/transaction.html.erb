<%= link_to "← My Activity", activity_path, class: "back" %><h1><%= link_to @revision.title, equipment_path(@exchange.listing_id) %></h1><span class="badge"><%= @exchange.state.upcase %></span>
<p>Donor: <%= @exchange.donor.display_name %> · Recipient: <%= @exchange.requester.display_name %></p>
<% if @identity.present? %><div class="note"><% if @document_confirmed && @exchange.state == 'pending' %><strong>Verified Recipient Identity</strong><% elsif @document_confirmed %><strong>Recipient identity — <%= @name_corrected ? "Requester-corrected" : "Verified" %></strong><p><%= @name_corrected ? "The requester corrected the extracted name and confirmed it against their document." : "Document-extracted details confirmed by the requester." %> Document authenticity and identity have not been independently verified.</p><% else %><strong>Recipient identity — SIMULATED</strong><% end %><p>Name: <%= [@identity['first_name'],@identity['last_name']].join(' ') %><br>ZIP: <%= @identity['zip_code'] %></p></div><% end %>
<% if @exchange.state == 'pending' %><p>Please respond by <%= @exchange.pending_expires_at.in_time_zone('America/Los_Angeles').strftime('%b %-d, %Y %-I:%M %p %Z') %>.</p><% if @exchange.donor_id == current_account.id %>
<section class="panel"><h2>Approve and suggest pickup</h2><%= form_with url: change_transaction_path(@exchange), class: "journey-form" do |f| %><%= hidden_field_tag :event, 'approve' %><%= f.label :meeting_at, 'Day and time (Pacific Time)' %><%= f.datetime_local_field :meeting_at, required: true %><%= f.label :location, 'Public pickup location' %><%= f.text_field :location, list: "bay-area-locations", autocomplete: "off", placeholder: "Public venue, town or ZIP code", required: true, maxlength: 300 %><p class="muted">Choose a public meeting place in the Bay Area. Type a town or ZIP code for suggestions, then include the venue and meeting point.</p><%= f.button 'Approve', class: 'primary' %><% end %><div class="actions"><%= button_to 'Decline', change_transaction_path(@exchange), params: {event: 'decline'} %><%= button_to 'Unavailable', change_transaction_path(@exchange), params: {event: 'unavailable'} %></div></section><% end %><% end %>
<% if @proposal && %w[offered reserved].include?(@exchange.state) %><section class="panel"><h2>Suggested handoff</h2><p>Proposed by <%= Account.find(@proposal.proposed_by).display_name %></p><p><%= @proposal.meeting_at.in_time_zone('America/Los_Angeles').strftime('%b %-d, %Y %-I:%M %p %Z') %><br><%= local_text(@proposal.public_location_ciphertext) %></p>
<% if HandoffAcceptance.exists?(proposal_id: @proposal.id) %><span class="badge">HANDOFF ARRANGEMENT ACCEPTED</span><% elsif @proposal.proposed_by != current_account.id %><%= button_to 'Accept suggested handoff', change_transaction_path(@exchange), params: {event: 'accept', proposal_id: @proposal.id}, class: 'primary' %><% else %><p>Waiting for the other participant to respond.</p><% end %>
<% if @exchange.state == 'reserved' || @exchange.requester_id == current_account.id %><details><summary class="button-link">Suggest a different day/time or location</summary><%= form_with url: change_transaction_path(@exchange), class: "journey-form" do |f| %><%= hidden_field_tag :event, 'propose' %><%= hidden_field_tag :proposal_id, @proposal.id %><%= f.label :meeting_at, 'Day and time (Pacific Time)' %><%= f.datetime_local_field :meeting_at, value: @proposal.meeting_at.in_time_zone('America/Los_Angeles').strftime('%Y-%m-%dT%H:%M'), required: true %><%= f.label :location %><%= f.text_field :location, list: "bay-area-locations", autocomplete: "off", placeholder: "Public venue, town or ZIP code", value: local_text(@proposal.public_location_ciphertext), required: true, maxlength: 300 %><p class="muted">Choose a public meeting place in the Bay Area. Type a town or ZIP code for suggestions, then include the venue and meeting point.</p><%= f.button 'Send suggestion', class: 'primary' %><% end %></details><% end %></section><% end %>
<% if %w[offered reserved].include?(@exchange.state) %><div class="note<%= ' safety-warning' if @exchange.state == 'offered' %>"><div class="safety-warning-heading"><% if @exchange.state == 'offered' %><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 4.5 2.2 18.5A2 2 0 0 0 4 21h16a2 2 0 0 0 1.8-2.5L13.7 4.5a2 2 0 0 0-3.4 0Z"/><path d="M12 9v5m0 3h.01"/></svg><% end %><strong>Safe Handoff</strong></div><p>Choose a public, nonresidential place and meet in daylight while the venue is open. You and the donor arrange pickup; FreeDME does not arrange transport.</p><p>FreeDME is not responsible for any travel related issues, incidents, no-shows or unsuccessful transfer of equipment for any other reasons.</p></div><% end %>
<div class="actions"><% if @exchange.state == 'reserved' %><%= button_to 'Confirm actual handoff', change_transaction_path(@exchange), params: {event: 'handoff'}, class: 'primary' %><% end %>
<% if @exchange.state == 'loaned' %><p>Loan until <%= @revision.loan_until %></p><% if current_account.id == @exchange.donor_id %><%= button_to 'Confirm equipment returned', change_transaction_path(@exchange), params: {event: 'return'}, class: 'primary' %><% end %><% end %>
<% if %w[pending offered reserved].include?(@exchange.state) %><%= button_to 'Cancel request / offer', change_transaction_path(@exchange), params: {event: 'cancel'} %><% if current_account.id == @exchange.requester_id %><%= button_to 'Revoke consent and cancel', change_transaction_path(@exchange), params: {event: 'revoke'} %><% end %><% end %></div>

<%= render "shared/location_options" %>
