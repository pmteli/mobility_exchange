<article class="card"><div class="image"><span class="badge <%= item.offer_kind == 'loan' ? 'loan' : '' %>"><%= offer_label(item) %></span><% cover = equipment_photos(Listing.find(item.id).approved_revision_id).first %><%= image_tag(cover ? equipment_photo_path(cover) : "/prototype-assets/equipment-placeholder.svg", alt: item.title, loading: "lazy") %></div><div class="card-body"><h3><%= link_to item.title, equipment_path(item) %></h3><p class="muted"><%= item.condition_description %> · Donor reported</p><div class="meta"><span>⌖ <%= item.public_locality %></span></div><%= link_to "View equipment →", equipment_path(item), class: "button-link" %></div></article>