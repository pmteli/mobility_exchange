<% if @moderator_view %>
  <%= link_to "← Back to Listing Reviews", activity_path(anchor: "panel-review"), class: "back" %>
<% elsif current_account && @listing.donor_id == current_account.id %>
  <%= link_to "← Back to My Activity", activity_path, class: "back" %>
<% else %>
  <%= link_to "← Back to equipment", equipment_index_path, class: "back" %>
<% end %>
<div class="split"><div><%= render "shared/equipment_gallery", revision_id: @item.id, title: @item.title %><%= render "shared/safe_meeting_warning" %></div><div><span class="badge"><%= offer_label(@item) %></span><h1 class="equipment-title"><%= @item.title %></h1><p class="badge"><%= @held && @listing.status == 'available' ? 'PENDING REQUEST' : @listing.status.humanize.upcase %></p><% if @held || @listing.status != 'available' %><p>New requests are closed.</p><% end %><p class="muted">⌖ <%= @item.public_locality %></p><p><%= @item.description %></p><div class="data"><div><small>Condition</small><%= @item.condition_description %><small>Self-attested, not inspected</small></div><div><small>Offered by</small><%= @donor_name %></div><div><small>Manufacturer / model</small><%= [@item.manufacturer, @item.model].compact.join(" / ").presence || "Not supplied" %></div><div><small>Collection</small><%= @item.pickup_availability %></div></div><div class="note"><b>Donor disclosures</b><p>Capacity: <%= @item.capacity_description.presence || "Not supplied" %>. Ask a qualified professional about fit and follow manufacturer instructions.</p></div><% if @listing.status == 'available' && !@held && @listing.donor_id != current_account&.id %><div class="actions"><%= link_to "Request this item", new_equipment_request_path(@listing), class: "button-link primary" %><a class="button-link" href="#ask-question">Ask A Question</a></div><% end %>
<% if @listing.status == 'available' && @listing.donor_id != current_account&.id %><section id="ask-question"><h2>Ask A Question</h2><% if current_account %><%= form_with url: equipment_questions_path(@listing), class: "journey-form" do |f| %><%= f.label :question, "Your question about this equipment" %><%= f.text_area :question, required: true, maxlength: 2000 %><%= f.button "Send question", class: "primary" %><% end %><% else %><%= link_to "Sign in to ask a question", sign_in_path %><% end %></section><% end %></div></div>