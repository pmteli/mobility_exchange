<h1>Free equipment. Local connections.</h1><p class="muted">Browse freely. Sign in only when you’re ready to request an item.</p>
<%= form_with url: equipment_index_path, method: :get do |form| %><div class="filters"><label>Search equipment or location<%= form.search_field :query, value: params[:query], placeholder: "Try walker or Oakland", maxlength: 100 %></label><label>Category<%= form.select :category_id, @categories.map { |c| [c.name, c.id] }, { include_blank: "All equipment", selected: params[:category_id] } %></label><label>Gift or loan<%= form.select :offer_kind, [["Free to keep", "gift"], ["Free loan", "loan"]], { include_blank: "Gifts & loans", selected: params[:offer_kind] } %></label></div><div class="actions"><%= form.button "Search", class: "primary" %><%= link_to "Clear filters", equipment_index_path, class: "button-link" %></div><% end %>
<div class="category-row"><%= link_to "All equipment", equipment_index_path, class: "chip button-link #{params[:category_id].blank? ? 'active' : ''}" %><% @categories.each do |category| %><%= link_to category.name, equipment_index_path(request.query_parameters.merge(category_id: category.id, page: 1)), class: "chip button-link #{params[:category_id] == category.id ? 'active' : ''}" %><% end %></div>
<p role="status"><b><%= @equipment.size %> items on this page</b></p><% if @equipment.empty? %><div class="empty"><h2>No available equipment yet.</h2><p>Listings appear after screening and publication. Try another search or return later.</p><%= link_to "Review sample card designs →", design_preview_path("catalog") %></div><% end %>
<div class="grid"><%= render partial: "equipment/card", collection: @equipment, as: :item %></div><div class="actions"><% if @page > 1 %><%= link_to "← Previous", equipment_index_path(request.query_parameters.merge(page: @page - 1)) %><% end %><% if @equipment.size == EquipmentCatalog::PAGE_SIZE && @page < 1000 %><%= link_to "Next →", equipment_index_path(request.query_parameters.merge(page: @page + 1)) %><% end %></div>
