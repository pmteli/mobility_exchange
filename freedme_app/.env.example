# Export these variables in your shell; dotenv is not installed.
DATABASE_URL=postgresql://localhost/freedme_development
TEST_DATABASE_URL=postgresql://localhost/freedme_test
# Production also requires SECRET_KEY_BASE and a reviewed runtime database role.

# Enable only with dedicated AWS Textract permissions; SMS remains simulated.
TEXTRACT_ENABLED=false
AWS_REGION=us-west-2

# Managed backups: independent 32-byte key encoded as 64 hex characters.
# Keep the key outside backups; do not commit it. Worker creates a backup daily.
PRIVACY_BACKUP_KEY=
# Owner-run erasure is off by default. Enable only for the reviewed maintenance command.
PRIVACY_ERASURE_MAINTENANCE=0
