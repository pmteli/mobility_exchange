demo.freedme.org {
    header X-Robots-Tag "noindex, nofollow"
    redir https://www.freedme.org{uri} 302
}
www.freedme.org {
    encode zstd gzip
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Cache-Control "no-cache"
    }
    @public_policies path /privacy.html /sms-terms.html /sms-consent.html /policy-assets/* /community-care-logo.png
    handle @public_policies {
        root * /srv/coming-soon
        file_server
    }
    @twilio_callbacks path /webhooks/twilio/incoming /webhooks/twilio/status
    handle @twilio_callbacks {
        reverse_proxy freedme-rails-preview:3000
    }
    handle {
        basic_auth {
            reviewer {$FREEDME_REVIEWER_HASH}
        }
        route {
            redir /journeys /journeys/ 308
            handle /journeys/* {
                root * /srv
                file_server
            }
            handle {
                reverse_proxy freedme-rails-preview:3000
            }
        }
    }
}
