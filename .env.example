# Example only. Export values in your shell or your deployment's secret manager.
DATABASE_URL=postgresql://localhost/mobility_exchange_development
TEST_DATABASE_URL=postgresql://localhost/mobility_exchange_test
APP_HOST=localhost
APP_PORT=3000
PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# Production additionally requires SECRET_KEY_BASE, ENCRYPTION_PRIMARY_KEY,
# ENCRYPTION_DETERMINISTIC_KEY, ENCRYPTION_KEY_DERIVATION_SALT, REDIS_URL,
# SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, MAIL_FROM.
# Set APP_PORT=443 in production. Never commit real secrets.

# Enable real delivery in development only when ready; default is file.
MAIL_DELIVERY_METHOD=file
MAIL_FROM=admin@mobilityexchange.org
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=admin@mobilityexchange.org
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
SMTP_AUTHENTICATION=plain
# Use SMTP_TLS_MODE=tls and SMTP_PORT=465 for implicit TLS.
# SMTP_DOMAIN defaults to APP_HOST (SMTP HELO domain).
